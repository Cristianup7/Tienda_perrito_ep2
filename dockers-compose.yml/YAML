version: '3.8'

services:
  db:
    image: mysql:8
    container_name: tienda-db
    environment:
      MYSQL_ROOT_PASSWORD: admin123
      MYSQL_DATABASE: tienda_perritos
    volumes:
      - dbdata:/var/lib/mysql
      # Esto inyecta tus datos de prueba automáticamente al crear la DB
      - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql
    ports:
      - "3306:3306"

  backend:
    build:
      context: ./backend
    container_name: tienda-backend
    environment:
      # Las variables que pide tu server.js
      DB_HOST: db  # Se conecta por el nombre del contenedor de la DB
      DB_USER: root
      DB_PASSWORD: admin123
      DB_NAME: tienda_perritos
      DB_PORT: 3306
    ports:
      - "3001:3001"
    depends_on:
      - db

  frontend:
    build:
      context: ./frontend
    container_name: tienda-frontend
    ports:
      # Mapeamos el puerto 80 del servidor EC2 al 8080 interno de Nginx
      - "80:8080"
    depends_on:
      - backend

volumes:
  dbdata: